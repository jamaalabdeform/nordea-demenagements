# URL publique du site (canonical, sitemap, OpenGraph)
NEXT_PUBLIC_SITE_URL=https://www.nordea-demenagements.fr
# Code d'accès à /admin-demo (démo uniquement — remplacer par une vraie auth en production)
ADMIN_DEMO_CODE=nordea-demo
# Optionnel : webhook où transmettre chaque demande (CRM, Make, Zapier, n8n…)
LEAD_WEBHOOK_URL=
# Optionnel : identifiants analytics (activés seulement s'ils sont renseignés)
NEXT_PUBLIC_GTM_ID=
# Mettre à 1 quand Stripe est configuré (masque la mention « mode démonstration »)
NEXT_PUBLIC_STRIPE_ENABLED=
# Paiement de l'acompte (Stripe Checkout). Sans clé : paiement simulé (démo).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
